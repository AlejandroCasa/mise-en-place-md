# Shared PostgreSQL 16 (Docker / k3s local -> portable to AWS RDS Free Tier)
POSTGRES_DB=gastronomy
POSTGRES_USER=gastronomy
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_PORT=5432

# Mise en Place MD settings
MISE_PORT=8001
MISE_DATABASE_URL=postgresql+psycopg://gastronomy:change-me-local-dev-only@127.0.0.1:5432/gastronomy
MISE_VINUM_PULSE_BASE_URL=http://127.0.0.1:8000
MISE_CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:8000,http://localhost:8001
